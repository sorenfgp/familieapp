rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /households/{code} {
      // Opret en familie: man skal selv stå på medlemslisten.
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.members;

      // Læs familien: kun medlemmer.
      allow get: if request.auth != null
        && request.auth.uid in resource.data.members;

      // Deltag med kode: man må kun tilføje sig selv til medlemslisten.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.resource.data.members.hasAll(resource.data.members)
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.auth.uid in request.resource.data.members;

      // Opskrifter, madplan, indkøbsliste og faste varer: kun medlemmer.
      match /{collection}/{doc} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/households/$(code)).data.members;
      }
    }
  }
}
